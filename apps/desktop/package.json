{
  "name": "notesnook-vue-desktop",
  "version": "0.2.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "A from-scratch Vue 3 + Tailwind + Glassmorphism rewrite of the Notesnook desktop frontend.",
  "author": "Marco Laux",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild:electron": "node ../../scripts/rebuild-electron.mjs",
    "package": "npm run rebuild:electron && electron-builder --config electron-builder.yml --publish never",
    "package:dir": "npm run rebuild:electron && electron-builder --config electron-builder.yml --dir --publish never",
    "package:mac": "npm run rebuild:electron && electron-builder --config electron-builder.yml --mac --publish never",
    "package:win": "npm run rebuild:electron && electron-builder --config electron-builder.yml --win --publish never",
    "package:linux": "npm run rebuild:electron && electron-builder --config electron-builder.yml --linux --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "@streetwriters/kysely": "~0.27.4",
    "@trpc/server": "^10.45.2",
    "better-sqlite3-multiple-ciphers": "^12.4.1",
    "electron-trpc": "^0.7.1",
    "electron-updater": "^6.8.9",
    "sqlite-better-trigram": "^0.0.6",
    "sqlite3-fts5-html": "^0.0.6",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "sqlite-better-trigram-darwin-arm64": "^0.0.6",
    "sqlite-better-trigram-darwin-x64": "^0.0.6",
    "sqlite-better-trigram-linux-x64": "^0.0.6",
    "sqlite-better-trigram-windows-x64": "^0.0.6",
    "sqlite3-fts5-html-darwin-arm64": "^0.0.6",
    "sqlite3-fts5-html-darwin-x64": "^0.0.6",
    "sqlite3-fts5-html-linux-x64": "^0.0.6",
    "sqlite3-fts5-html-windows-x64": "^0.0.6"
  },
  "devDependencies": {
    "@notesnook-vue/contracts": "*",
    "@notesnook-vue/editor-vue": "*",
    "@notesnook-vue/shared": "*",
    "@notesnook-vue/theme-vue": "*",
    "@notesnook-vue/ui-vue": "*",
    "@notesnook/core": "~8.1.3",
    "@notesnook/crypto": "~2.1.3",
    "@notesnook/editor": "~2.1.3",
    "@notesnook/logger": "~2.1.3",
    "@notesnook/sodium": "~2.1.3",
    "@notesnook/streamable-fs": "~2.1.3",
    "@notesnook/theme": "~2.1.3",
    "@tailwindcss/vite": "^4.0.0",
    "@tiptap/core": "2.6.6",
    "@tiptap/pm": "2.6.6",
    "@tiptap/starter-kit": "2.6.6",
    "@tiptap/vue-3": "2.6.6",
    "@trpc/client": "^10.45.2",
    "@types/better-sqlite3": "^7.6.5",
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "37.10.3",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "@lucide/vue": "^1.25.0",
    "pinia": "^2.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.4.0",
    "vue-tsc": "^2.1.0"
  }
}
