{
  "name": "notesnook-vue",
  "version": "0.4.7",
  "private": true,
  "description": "A from-scratch Vue 3 + Tailwind + Glassmorphism rewrite of the Notesnook desktop frontend.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor-dist/@notesnook/core",
    "vendor-dist/@notesnook/crypto",
    "vendor-dist/@notesnook/logger",
    "vendor-dist/@notesnook/sodium",
    "vendor-dist/@notesnook/streamable-fs",
    "vendor-dist/@notesnook/editor",
    "vendor-dist/@notesnook/theme"
  ],
  "overrides": {
    "@tiptap/core": "2.6.6",
    "@tiptap/pm": "2.6.6",
    "@tiptap/vue-3": "2.6.6",
    "@tiptap/starter-kit": "2.6.6",
    "@tiptap/suggestion": "2.6.6",
    "@tiptap/extension-blockquote": "2.6.6",
    "@tiptap/extension-bold": "2.6.6",
    "@tiptap/extension-bubble-menu": "2.6.6",
    "@tiptap/extension-bullet-list": "2.6.6",
    "@tiptap/extension-character-count": "2.6.6",
    "@tiptap/extension-code-block": "2.6.6",
    "@tiptap/extension-code": "2.6.6",
    "@tiptap/extension-color": "2.6.6",
    "@tiptap/extension-document": "2.6.6",
    "@tiptap/extension-dropcursor": "2.6.6",
    "@tiptap/extension-floating-menu": "2.6.6",
    "@tiptap/extension-font-family": "2.6.6",
    "@tiptap/extension-gapcursor": "2.6.6",
    "@tiptap/extension-hard-break": "2.6.6",
    "@tiptap/extension-highlight": "2.6.6",
    "@tiptap/extension-heading": "2.6.6",
    "@tiptap/extension-history": "2.6.6",
    "@tiptap/extension-horizontal-rule": "2.6.6",
    "@tiptap/extension-italic": "2.6.6",
    "@tiptap/extension-list-item": "2.6.6",
    "@tiptap/extension-list-keymap": "2.6.6",
    "@tiptap/extension-ordered-list": "2.6.6",
    "@tiptap/extension-paragraph": "2.6.6",
    "@tiptap/extension-placeholder": "2.6.6",
    "@tiptap/extension-strike": "2.6.6",
    "@tiptap/extension-subscript": "2.6.6",
    "@tiptap/extension-superscript": "2.6.6",
    "@tiptap/extension-table": "2.6.6",
    "@tiptap/extension-table-cell": "2.6.6",
    "@tiptap/extension-table-header": "2.6.6",
    "@tiptap/extension-table-row": "2.6.6",
    "@tiptap/extension-task-item": "2.6.6",
    "@tiptap/extension-task-list": "2.6.6",
    "@tiptap/extension-text": "2.6.6",
    "@tiptap/extension-text-align": "2.6.6",
    "@tiptap/extension-text-style": "2.6.6",
    "@tiptap/extension-underline": "2.6.6"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/desktop",
    "predev": "npm run rebuild:electron",
    "build": "npm run build --workspace=apps/desktop",
    "rebuild:electron": "node scripts/rebuild-electron.mjs",
    "gen:hosts": "node scripts/gen-production-hosts.mjs",
    "gen:upstream-baseline": "node scripts/gen-upstream-baseline.mjs",
    "build:vendor:src": "node scripts/build-vendor-from-source.mjs",
    "vendor:bump": "node scripts/vendor-bump.mjs",
    "vendor:check": "node scripts/vendor-check.mjs",
    "release:bump": "node scripts/release-bump.mjs",
    "typecheck": "npm run typecheck --workspace=apps/desktop --if-present && npm run typecheck --workspace=packages/contracts --if-present",
    "test:contract": "vitest run --dir tests/contract",
    "pretest:contract": "npm rebuild better-sqlite3-multiple-ciphers",
    "test:contract:watch": "vitest --dir tests/contract",
    "pretest:contract:watch": "npm rebuild better-sqlite3-multiple-ciphers",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@types/node": "^22.10.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.10.0",
    "happy-dom": "^15.0.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "@notesnook/core@8.1.3": true,
    "@notesnook/editor@2.1.3": true,
    "@notesnook/sodium@2.1.3": true,
    "better-sqlite3-multiple-ciphers@12.11.1": true,
    "electron@37.10.3": true,
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "sqlite-vec": "^0.1.9"
  }
}
